{
  "$defs": {},
  "$id": "urn:artifact-server:schema:artifact-server.views.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "artifact-server.views"
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "number",
          "enum": [
            1
          ]
        }
      ]
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "defaultScenarioId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
          },
          "label": {
            "type": "string",
            "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$",
            "maxLength": 200
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "default": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 256
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                },
                "prop": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "propValue": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 256
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 256
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    },
                    "required": [
                      "propValue",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2,
                  "maxItems": 16
                }
              },
              "required": [
                "default",
                "name",
                "prop",
                "values"
              ],
              "additionalProperties": false
            },
            "maxItems": 8
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}]+$",
                  "maxLength": 200
                },
                "props": {
                  "type": "object",
                  "patternProperties": {
                    "^[A-Za-z_][A-Za-z0-9_]{0,63}$": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 256
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1,
                  "maxProperties": 16
                },
                "scenarioId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
                }
              },
              "required": [
                "label",
                "props",
                "scenarioId"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 200
          },
          "sourceRef": {
            "type": "object",
            "properties": {
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "viewId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$",
            "maxLength": 128
          }
        },
        "required": [
          "defaultScenarioId",
          "label",
          "parameters",
          "path",
          "scenarios",
          "sourceRef",
          "viewId"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "required": [
    "format",
    "version",
    "views"
  ],
  "additionalProperties": false
}
